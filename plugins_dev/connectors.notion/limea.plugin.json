{
  "id": "connectors.notion",
  "name": "Notion",
  "version": "2.0.0",
  "apiVersion": 10,
  "hostVersion": ">=0.1.0",
  "entry": "backend.mjs",
  "toolPresentation": {
    "name": "Notion",
    "icon": "assets/icon.png"
  },
  "connections": [
    {
      "provider": "notion",
      "permissionSet": "notion-read-write"
    }
  ],
  "tools": [
    {
      "id": "search",
      "name": "搜索页面",
      "description": "搜索用户授权给 LimeA 的 Notion 页面标题。不会搜索页面正文。结果只覆盖已共享页面；空结果不代表工作区无内容。nextCursor 可用于下一页。 返回 connection-result-too-large 时，使用更小的 pageSize（最小 1）和同一 cursor 重试。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 256
          },
          "cursor": {
            "type": "string",
            "maxLength": 256
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": []
      },
      "modes": ["work", "chat", "learn", "group"]
    },
    {
      "id": "page",
      "name": "读取页面信息",
      "description": "读取一个已授权页面的标题与受支持属性。pageId 使用搜索结果里的页面 ID；正文用 children 读取。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pageId": {
            "type": "string"
          }
        },
        "required": ["pageId"]
      },
      "modes": ["work", "chat", "learn", "group"]
    },
    {
      "id": "children",
      "name": "读取页面内容",
      "description": "分页读取页面或块的直接子块（每页最多 50 个），以文本形式返回。hasChildren 的块需要用其 id 再调用本工具；不下载附件、不自动访问外链。nextCursor 可用于下一页。 返回 connection-result-too-large 时，使用更小的 pageSize（最小 1）和同一 cursor 重试。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "blockId": {
            "type": "string"
          },
          "cursor": {
            "type": "string",
            "maxLength": 256
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": ["blockId"]
      },
      "modes": ["work", "chat", "learn", "group"]
    },
    {
      "id": "search_sources",
      "name": "搜索数据源",
      "description": "按标题搜索已共享的数据源；支持分页。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 256
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": []
      },
      "modes": ["work", "chat", "learn", "group"]
    },
    {
      "id": "database",
      "name": "读取数据库",
      "description": "读取数据库与其数据源列表。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "databaseId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 36
          }
        },
        "required": ["databaseId"]
      },
      "modes": ["work", "chat", "learn", "group"]
    },
    {
      "id": "source",
      "name": "读取数据源",
      "description": "读取数据源属性名称、标识与类型。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 36
          }
        },
        "required": ["sourceId"]
      },
      "modes": ["work", "chat", "learn", "group"]
    },
    {
      "id": "query_source",
      "name": "查询数据源",
      "description": "查询数据源记录；支持官方过滤条件、排序与分页。requestStatus 不完整时结果不是完整集合。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 36
          },
          "filter": {
            "type": "object",
            "additionalProperties": true
          },
          "sorts": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": ["sourceId"]
      },
      "modes": ["work", "chat", "learn", "group"]
    },
    {
      "id": "comments",
      "name": "读取评论",
      "description": "读取共享页面或内容块上的评论；支持分页。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "blockId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 36
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": ["blockId"]
      },
      "modes": ["work", "chat", "learn", "group"]
    },
    {
      "id": "request_write",
      "name": "修改 Notion 内容",
      "description": "仅在用户要求修改 Notion 时使用，逐次写入均需用户审批。支持创建或更新页面、数据库、数据源、视图，移动页面及更新页面 Markdown，追加或编辑内容块、将块移到回收站，以及创建、更新或删除评论。写入结果不明时严禁自动重试，先让用户核对目标。method 为 POST/PATCH/DELETE，path 仅支持 /v1/pages、/v1/databases、/v1/data_sources、/v1/comments、/v1/views；/v1/pages/{id}、/v1/pages/{id}/move、/v1/pages/{id}/markdown、/v1/blocks/{id}、/v1/blocks/{id}/children、/v1/databases/{id}、/v1/data_sources/{id}、/v1/views/{id}、/v1/comments/{id}；POST 和 PATCH 必须提供符合 Notion API 的 body 对象，DELETE 仅支持 blocks、views 和 comments 的 /v1/.../{id} 且不带 body。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "method": {
            "type": "string",
            "enum": ["POST", "PATCH", "DELETE"]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "body": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["method", "path"]
      },
      "modes": ["work", "chat", "learn", "group"]
    },
    {
      "id": "read_resource",
      "name": "读取视图、成员或页面属性",
      "description": "读取 Notion 中已授权的对象：kind 为 block（需 id）、page_property（页面 id、propertyId，可分页）、user（用户 id）、current_user、users（可分页）、comment（评论 id）、view（视图 id）、views（databaseId 或 sourceId 二选一，可分页）、templates（数据源 id，可分页及 name 过滤）、markdown（页面 id）。页面属性 ID 解码后不能含斜线、反斜线、控制字符、%、? 或 #。结果有 incomplete 时查看 issues，不可将其视为完整数据。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "block",
              "page_property",
              "user",
              "current_user",
              "users",
              "comment",
              "view",
              "views",
              "templates",
              "markdown"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 32,
            "maxLength": 36
          },
          "propertyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "databaseId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 36
          },
          "sourceId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 36
          },
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": ["kind"]
      },
      "modes": ["work", "chat", "learn", "group"]
    }
  ],
  "page": {
    "entry": "page.mjs",
    "description": "连接 Notion 工作区，搜索和阅读已共享页面，并经确认后编辑内容。",
    "author": "Playa",
    "illustration": "assets/banner.png"
  },
  "resources": ["assets/icon.png"]
}
